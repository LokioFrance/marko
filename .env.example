# ─────────────────────────────────────────────────────────────────────────────
# MARKO — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs avant le déploiement.
# NE JAMAIS committer le fichier .env sur git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────

# Clé secrète Django — générer avec :
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key

# Passer à false en production
DJANGO_DEBUG=false

# Hosts autorisés, séparés par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Sécurité / Admin ──────────────────────────────────────────────────────────

# URL secrète de la vraie interface d'administration Django (sans slash de début/fin).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(16))"
# /admin/ est un honeypot et loggue toutes les tentatives dans honeypot.log.
DJANGO_ADMIN_URL=changeme-secret-admin-url

# ── Superutilisateur Django ───────────────────────────────────────────────────

# Créé automatiquement au premier déploiement si absent.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme-strong-password

# ── JWT ───────────────────────────────────────────────────────────────────────

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Gunicorn ──────────────────────────────────────────────────────────────────

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30

# ── Docker / Réseau ───────────────────────────────────────────────────────────

# Port exposé sur l'hôte pour l'API marko (le conteneur écoute sur 8000)
HOST_PORT=8003

# ── Honeypot ──────────────────────────────────────────────────────────────────

# Clé partagée pour sécuriser l'endpoint GET /api/honeypot/.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
HONEYPOT_API_KEY=changeme-honeypot-key

# ── MCP (Model Context Protocol) ──────────────────────────────────────────────

MCP_PORT=9000
MCP_HOST_PORT=9005

# Clé optionnelle pour sécuriser l'accès MCP (header X-MCP-Key).
MCP_API_KEY=changeme-or-leave-empty
